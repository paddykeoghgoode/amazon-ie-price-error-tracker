# Copy to .env and fill in values

# Telegram (recommended — create a bot via @BotFather, then message @userinfobot for chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Twilio WhatsApp (https://www.twilio.com/docs/whatsapp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+353...

# Monitoring
POLL_INTERVAL_SECONDS=45
REQUEST_DELAY_SECONDS=2

# Price-error heuristics
MIN_DISCOUNT_PERCENT=75
MIN_LIST_PRICE_EUR=20
MAX_ALERT_PRICE_EUR=500
COOLDOWN_MINUTES=30

# Server
HOST=0.0.0.0
PORT=8080
DATABASE_PATH=data/tracker.db
